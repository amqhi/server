# ==========================================
# Server Configuration
# ==========================================
# Event loop pool size. Omit or leave empty to auto-match CPU core count.
EVENT_LOOP_POOL_SIZE=1

# Secret key for signing JWT access tokens
JWT_SECRET_KEY=your-jwt-secret-key-here
REFRESH_TOKEN_COOKIE_NAME=aq_rt_

# ==========================================
# Database (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amqhi
DB_USER=postgres
DB_PASSWORD=your-db-password

# ==========================================
# Object Storage (S3 / MinIO)
# ==========================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_NAME=amqhi-bucket
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_PATH_STYLE=true

# ==========================================
# Google OAuth (Optional)
# ==========================================
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=